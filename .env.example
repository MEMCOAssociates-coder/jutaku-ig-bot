# Copy this file to .env and fill in your real values. Never commit the real .env.

# A string you make up yourself. You'll enter the same value in the Meta
# App Dashboard webhook setup screen under "Verify Token".
VERIFY_TOKEN=choose-any-random-string-here

# One entry per Instagram account the bot answers:
#   <Instagram account ID>:<Facebook Page access token>, comma-separated.
# The Page token is the never-expiring Page token (starts with EAA...) of the
# Facebook Page linked to that Instagram account — from Graph API Explorer
# `me/accounts?fields=name,id,access_token,instagram_business_account`
# (see README). NOT the token from Instagram -> API setup -> Generate token.
PAGE_TOKENS=

# Single account only: you can set its Page token here instead of PAGE_TOKENS.
PAGE_ACCESS_TOKEN=

# App Secret from Meta App Dashboard -> App Settings -> Basic.
# Used to verify that incoming webhook calls really come from Meta.
# Leave blank only for local testing; set it for production.
APP_SECRET=

# Graph API version to call (keep in sync with what your app uses).
GRAPH_API_VERSION=v19.0

# Port the server listens on (most hosts set this for you automatically).
PORT=5000

# Minutes to wait for a reply before the "no response -> assume default"
# fallback fires for Rent/Share leads (Loan has no fallback — it just waits,
# per the diagram). Tune this to match how patient you want the bot to be.
WAIT_MINUTES=60

# Any random string. Required as the X-Admin-Token header on calls to
# POST /start_flow, so only you (or your ads/CRM tooling) can kick off a
# tracked conversation. Leave blank to disable the check (not recommended
# once this is live).
ADMIN_TOKEN=choose-another-random-string-here

# Campaign Reports in the CRM read the bot's message counts from GET /stats.
# Make up a long random string; put the SAME value in the CRM's .env as
# IG_BOT_STATS_KEY. Leave blank to keep /stats switched off.
STATS_KEY=

# Where the counts are kept (a small SQLite file). Default: stats.db next to app.py.
STATS_DB=
